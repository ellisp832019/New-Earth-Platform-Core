{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/mcp/neos-project-summary-resource.schema.json",
  "title": "NEOS Project Summary Payload",
  "type": "object",
  "required": ["project_id", "summary", "status", "updated_at"],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
