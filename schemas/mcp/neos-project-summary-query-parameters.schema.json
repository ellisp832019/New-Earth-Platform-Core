{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/mcp/neos-project-summary-query-parameters.schema.json",
  "title": "NEOS Project Summary Query Parameters",
  "type": "object",
  "properties": {
    "project_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "include_archived": {
      "type": "boolean"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
