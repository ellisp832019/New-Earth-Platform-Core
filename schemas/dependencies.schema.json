{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New Earth Dependency Registry",
  "type": "object",
  "required": [
    "registry_version",
    "dependencies"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "kind",
          "contract",
          "required"
        ],
        "properties": {
          "source": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {
            "enum": [
              "compatible_with",
              "consumes",
              "controls",
              "depends_on",
              "observes",
              "provides",
              "publishes",
              "subscribes"
            ]
          },
          "contract": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "required": {"type": "boolean"},
          "status": {
            "enum": ["active", "planned", "optional", "future", "not_required", "deferred"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
