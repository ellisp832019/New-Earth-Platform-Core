{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New Earth Dependency Registry",
  "type": "object",
  "required": [
    "registry_version",
    "dependencies"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "kind",
          "contract",
          "required"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}