{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/project-contract.schema.json",
  "title": "New Earth Project Contract",
  "type": "object",
  "required": [
    "contract_version",
    "project",
    "repository",
    "design",
    "engineering",
    "integrations",
    "provides",
    "consumes",
    "governance"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "family", "type", "owner", "status", "maturity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 2},
        "family": {"type": "string", "minLength": 2},
        "type": {"type": "string", "minLength": 2},
        "owner": {"type": "string", "minLength": 2},
        "status": {"enum": ["active", "developing", "planned", "deprecated", "archived"]},
        "maturity": {"enum": ["foundation", "prototype", "development", "alpha", "beta", "production"]}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["version", "versioning", "default_branch", "release_channel"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]+)?$"},
        "versioning": {"enum": ["semver"]},
        "default_branch": {"type": "string", "minLength": 1},
        "release_channel": {
          "enum": ["development", "alpha", "beta", "release-candidate", "stable", "deprecated"]
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": ["system", "version", "shell", "personality", "accessibility"],
      "properties": {
        "system": {"enum": ["NEDS"]},
        "version": {"type": "string", "minLength": 1},
        "shell": {"type": "string", "minLength": 1},
        "personality": {"type": "string", "minLength": 1},
        "accessibility": {"enum": ["required", "not-applicable"]}
      },
      "additionalProperties": false
    },
    "engineering": {
      "type": "object",
      "required": ["local_first", "logging", "security", "ci", "testing", "documentation"],
      "properties": {
        "local_first": {"type": "boolean"},
        "logging": {"enum": ["none", "standard", "structured"]},
        "security": {"enum": ["baseline", "enhanced", "regulated"]},
        "ci": {"enum": ["required", "not-applicable"]},
        "testing": {"enum": ["required", "not-applicable"]},
        "documentation": {"enum": ["required", "not-applicable"]}
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "required": ["neos", "gaia", "command_centre"],
      "properties": {
        "neos": {"type": "boolean"},
        "gaia": {"type": "boolean"},
        "command_centre": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "consumes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "governance": {
      "type": "object",
      "required": ["owner_review", "architecture_review", "release_status"],
      "properties": {
        "owner_review": {"enum": ["required", "not-applicable"]},
        "architecture_review": {"enum": ["required", "not-applicable"]},
        "release_status": {"enum": ["in-development", "ready", "released", "deprecated"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
