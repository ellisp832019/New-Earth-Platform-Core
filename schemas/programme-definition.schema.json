{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/programme-definition.schema.json",
  "title": "New Earth Programme Definition V1",
  "description": "Portable governed programme definition. Describes proposed programme structure only; never live Programme Control operational state.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "programme",
    "work_packages",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "new-earth.programme.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "programme": {
      "type": "object",
      "required": [
        "programme_id",
        "lane_id",
        "name",
        "objective"
      ],
      "properties": {
        "programme_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "lane_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "repository_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "repository_id",
          "required"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "baseline_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "platform_contract_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_package_id",
          "title",
          "objective",
          "scope",
          "acceptance_criteria",
          "dependencies",
          "blockers",
          "authority_required",
          "approval_required",
          "evidence_required",
          "tasks"
        ],
        "properties": {
          "work_package_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blockers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_required": {
            "enum": [
              "OBSERVE",
              "RECOMMEND",
              "PREPARE",
              "EXECUTE_WITH_APPROVAL",
              "AUTONOMOUS_PREAUTHORISED"
            ]
          },
          "approval_required": {
            "type": "boolean"
          },
          "evidence_required": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "order",
                "title",
                "objective",
                "acceptance_criteria",
                "blockers"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "objective": {
                  "type": "string",
                  "minLength": 1
                },
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "blockers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "controls": {
            "type": "object",
            "properties": {
              "stop_conditions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rollback_boundary": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "author"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "additionalProperties": false
}
