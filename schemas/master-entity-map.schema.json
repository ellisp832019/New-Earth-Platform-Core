{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "mapping_version",
    "namespace",
    "mappings"
  ],
  "properties": {
    "mapping_version": {
      "const": "1.0"
    },
    "namespace": {
      "const": "new-earth-master-architecture"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "external_id",
          "platform_core_id",
          "canonical_name",
          "target_kind",
          "mapping_state"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "pattern": "^NE-[A-Z]+-[0-9]{3}$"
          },
          "platform_core_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 2
          },
          "target_kind": {
            "enum": [
              "project_and_governance",
              "governance_only"
            ]
          },
          "mapping_state": {
            "enum": [
              "existing",
              "reconciled",
              "new",
              "future"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
