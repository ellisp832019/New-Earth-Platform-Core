{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/mcp-resource.schema.json",
  "title": "New Earth MCP Resource",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "owner_system_id",
    "server_id",
    "capability_id",
    "resource_type",
    "schema_ref",
    "read_only",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*(?:_[a-z0-9]+)*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 2
    },
    "owner_system_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "server_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*(?:_[a-z0-9]+)*)+$"
    },
    "resource_type": {
      "enum": [
        "health",
        "status",
        "project",
        "repository",
        "engineering",
        "dependency",
        "decision",
        "architecture",
        "evidence",
        "knowledge",
        "diagnostic",
        "report",
        "registry"
      ]
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "read_only": {
      "const": true
    },
    "status": {
      "enum": ["planned", "declared", "active", "deprecated"]
    },
    "query_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*(?:_[a-z0-9]+)*)+$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
