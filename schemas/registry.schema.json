{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New Earth Project Registry",
  "type": "object",
  "required": [
    "registry_version",
    "projects"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "family",
          "type",
          "repository",
          "status",
          "contract"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "repository": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "developing", "planned", "deprecated", "archived"]},
          "contract": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
